{
  "name": "cloud-migration-simulator",
  "version": "1.0.0",
  "description": "Demonstrates lift-and-shift vs re-platform vs re-architect migration patterns using AWS services (via LocalStack), with serial vs parallel execution benchmarking and a caching layer.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start:legacy": "node legacy/server.js",
    "start:migrated": "node migrated/server.js",
    "start:worker": "node migrated/worker.js",
    "start:frontend": "node frontend/server.js",
    "benchmark": "node scripts/benchmark.js",
    "setup:aws-local": "node scripts/setup-localstack.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-sqs": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1"
  }
}
